# Pocket-only fitter settings. These preserve the core HDL behavior while
# reducing placement pressure enough for the Cyclone V in Analogue Pocket.
set_global_assignment -name SEED 1
set_global_assignment -name OPTIMIZATION_TECHNIQUE AREA
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION OFF
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION OFF
